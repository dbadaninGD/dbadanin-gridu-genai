# Copy this file to .env and fill in real values. docker-compose reads .env
# automatically from the repo root. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datagen_db

# --- GCP / Vertex AI ---
# The GCP project that hosts Vertex AI. Authentication itself is handled by
# mounting your local Application Default Credentials into the backend
# container (see docker-compose.yml) -- run this once on the host first:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: override the Gemini models used for each task.
# GENERATION_MODEL=gemini-2.5-pro
# REFINE_MODEL=gemini-2.5-flash
# QUERY_MODEL=gemini-2.5-pro

# --- Langfuse (observability) ---
# Leave blank to run without tracing -- the app still works, it just won't
# send traces anywhere.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
